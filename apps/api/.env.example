# Copy to .env (never commit real values).
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:3000

# Local docker Postgres (`pnpm db:up` from the repo root).
# On Supabase: DATABASE_URL = transaction pooler (port 6543), DIRECT_URL = session/direct (port 5432).
DATABASE_URL=postgresql://eco:eco@localhost:5432/eco
DIRECT_URL=postgresql://eco:eco@localhost:5432/eco

# Supabase → Project Settings. Used to verify access tokens (JWKS) — no secret needed.
SUPABASE_URL=

# Stripe → Developers → API keys (test mode during development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
